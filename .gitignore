*.pdf
*.zip
/plans/*/sources/
/.feasibility/**/fulltext/

# Third-party generated 3D models stay out of git; the F-16 traced from NASA's three-view and finished in Blender is ours
/web/public/aero/models/*.glb
!/web/public/aero/models/f16-traced.glb
