# nested repo with its own remote
/proofline/
# secrets and local env
.env
.env.*
*.pem
*.key
# dependencies and build output
node_modules/
.next/
.vercel/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
