{
  "name": "archymedes-defense-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "data": "python3 scripts/build_data.py",
    "dev": "next dev --hostname 127.0.0.1 --port 3310",
    "build": "mkdir -p public/vendor && cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs public/vendor/maplibre-gl-worker.mjs && next build && python3 scripts/check_bundle.py",
    "start": "next start --hostname 127.0.0.1 --port 3310",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests"
  },
  "dependencies": {
    "3d-tiles-renderer": "0.5.3",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "maplibre-gl": "6.16.0",
    "next": "16.4.5",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "fast-check": "4.10.2",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3"
  }
